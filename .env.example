# Copy to <workspace parent>/.env or <workspace>/.env. Never commit real keys.
# Literal single-line values only; quotes and trailing comments are supported.
# Process environment overrides workspace/.env, which overrides its parent/.env.
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-tts
OPENROUTER_TTS_VOICE=Kore

# Music and speech use independent models with the same API key.
OPENROUTER_MUSIC_MODEL=google/lyria-3-pro-preview

# Require owner-only .env permissions: chmod 600 .env
# Fail closed when no ZDR provider is available; never downgraded automatically.
OPENROUTER_REQUIRE_ZDR=true

# Optional music-only ZDR override. Set false only after accepting upstream retention.
OPENROUTER_MUSIC_REQUIRE_ZDR=true
# Text/audio analysis always enforces ZDR, even when music opts out.
OPENROUTER_ANALYSIS_MODEL=google/gemini-3.8-flash
